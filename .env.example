# Binance API Keys
BINANCE_API_KEY=binance_api_key_here
BINANCE_API_SECRET=binance_api_secret_here

# BingX API Keys (optional - get from https://bingx.com/en-us/account/api/)
BINGX_API_KEY=your_bingx_api_key_here
BINGX_API_SECRET=your_bingx_api_secret_here

# Telegram Bot (required for notifications)
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=8263252052:AAEzHCxknNAQSaGvuYQYps6fcbI9PS31epw
TELEGRAM_CHAT_ID=@crypto_6789_signals

# Trading Configuration
FUNDING_RATE_THRESHOLD=0.001  # 0.1% per 8h (minimum to trigger trade)
MIN_POSITION_SIZE_USDT=5      # Minimum position size in USDT (meets Binance MIN_NOTIONAL)
MAX_POSITION_SIZE_USDT=5      # Maximum position size in USDT (for testing)
MAX_ACTIVE_POSITIONS=1        # Max number of simultaneous positions (3x$5=$15, safe with $20 balance)

# Risk Management
TAKE_PROFIT_FUNDING=0.005     # Take profit when accumulated funding > 0.5%
STOP_LOSS_PERCENT=0.02        # Stop loss at 2% (emergency exit if hedge breaks)
REBALANCE_THRESHOLD=0.01      # Rebalance when delta > 1%

# Monitoring
SCAN_INTERVAL_SECONDS=60      # How often to scan for new opportunities
MIN_VOLUME_24H_USDT=10000000  # Min 24h volume: $10M (avoid illiquid coins)

# Exchange Settings
TESTNET=false                 # Set to true for testing on testnet
ENABLED_EXCHANGES=binance,bingx  # Comma-separated list: binance,bingx (BingX will be auto-disabled if no API key)
